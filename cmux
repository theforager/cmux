#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$SCRIPT_DIR/dist/cli.js" ]]; then
  exec node "$SCRIPT_DIR/dist/cli.js" "$@"
fi

if [[ -x "$SCRIPT_DIR/node_modules/.bin/tsx" ]]; then
  exec "$SCRIPT_DIR/node_modules/.bin/tsx" "$SCRIPT_DIR/src/cli.tsx" "$@"
fi

if [[ "${1:-}" == "legacy" ]]; then
  shift
  exec "$SCRIPT_DIR/legacy/cmux.bash" "$@"
fi

cat >&2 <<EOF
cmux TypeScript dependencies are not installed yet.

Run:
  npm install
  npm run build

Legacy cmux is still available:
  cmux legacy [command]
EOF
exit 1
