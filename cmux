#!/usr/bin/env bash
#
# cmux - Claude Tmux Session Manager
# Manage multiple Claude Code sessions via tmux
#

set -euo pipefail

VERSION="1.0.0"
# Using @ as separator since colons conflict with tmux session:window syntax
# and underscores are common in directory names
CMUX_PREFIX="cmux"
CMUX_SEP="@"

# Mobile-friendly terminal width (used with --mobile flag)
# Claude Code doesn't handle resize well, so mobile sessions start narrow
CMUX_MOBILE_WIDTH=78

# Colors (subtle, modern palette)
C_RESET='\e[0m'
C_BOLD='\e[1m'
C_DIM='\e[2m'
C_CYAN='\e[36m'
C_GREEN='\e[32m'
C_YELLOW='\e[33m'
C_BLUE='\e[34m'
C_MAGENTA='\e[35m'
C_RED='\e[31m'

# Status indicators (inspired by agent-deck)
STATUS_RUNNING="●"    # Claude is actively outputting
STATUS_WAITING="◐"    # Waiting for user input
STATUS_IDLE="○"       # Idle/no recent activity
STATUS_ERROR="✕"      # Error state

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

die() {
    echo "Error: $1" >&2
    exit 1
}

is_inside_tmux() {
    [[ -n "${TMUX:-}" ]]
}

# Get all cmux sessions (sessions starting with cmux prefix)
get_sessions() {
    tmux list-sessions -F "#{session_name}|#{session_created}" 2>/dev/null | \
        grep "^${CMUX_PREFIX}${CMUX_SEP}" || true
}

# Get session title from tmux environment
get_session_title() {
    local session="$1"
    tmux show-environment -t "$session" CMUX_TITLE 2>/dev/null | sed 's/^CMUX_TITLE=//' || echo ""
}

# Get session working directory
get_session_dir() {
    local session="$1"
    tmux show-environment -t "$session" CMUX_DIR 2>/dev/null | sed 's/^CMUX_DIR=//' || echo ""
}

# Format age from seconds to human readable
format_age() {
    local created="$1"
    local now
    now=$(date +%s)
    local diff=$((now - created))

    if ((diff < 60)); then
        echo "${diff}s"
    elif ((diff < 3600)); then
        echo "$((diff / 60))m"
    elif ((diff < 86400)); then
        echo "$((diff / 3600))h"
    else
        echo "$((diff / 86400))d"
    fi
}

# Generate session name from path
# /projects/rebar-cosmos/aggregation-logic → cmux_rebar-cosmos_aggregation-logic
generate_session_name() {
    local path="$1"
    local abs_path
    abs_path=$(cd "$path" && pwd)

    local parent
    parent=$(basename "$(dirname "$abs_path")")
    local child
    child=$(basename "$abs_path")

    local base_name="${CMUX_PREFIX}${CMUX_SEP}${parent}${CMUX_SEP}${child}"
    local name="$base_name"
    local counter=2

    # Handle duplicates
    while tmux has-session -t "$name" 2>/dev/null; do
        name="${base_name}-${counter}"
        ((counter++))
    done

    echo "$name"
}

# Extract parent from session name for grouping
# cmux@rebar-cosmos@aggregation-logic → rebar-cosmos
get_session_parent() {
    local session="$1"
    echo "$session" | cut -d"${CMUX_SEP}" -f2
}

# Extract child from session name
# cmux@rebar-cosmos@aggregation-logic → aggregation-logic
get_session_child() {
    local session="$1"
    echo "$session" | cut -d"${CMUX_SEP}" -f3-
}

# Get session status (running/waiting/idle/error)
# Returns: status_symbol|color
get_session_status() {
    local session="$1"

    # Get pane activity timestamp
    local last_activity
    last_activity=$(tmux display-message -t "$session" -p '#{pane_last_activity}' 2>/dev/null) || {
        echo "${STATUS_ERROR}|${C_RED}"
        return
    }

    local now
    now=$(date +%s)
    local idle_seconds=$((now - last_activity))

    # Capture last few lines of the pane to detect state
    local pane_content
    pane_content=$(tmux capture-pane -t "$session" -p -S -5 2>/dev/null | tr -d '\0') || {
        echo "${STATUS_ERROR}|${C_RED}"
        return
    }

    # Get the last non-empty line
    local last_line
    last_line=$(echo "$pane_content" | grep -v '^[[:space:]]*$' | tail -1)

    # Check for error patterns
    if echo "$last_line" | grep -qiE '(error|exception|failed|panic|fatal)'; then
        echo "${STATUS_ERROR}|${C_RED}"
        return
    fi

    # Activity within last 2 seconds = running
    if [[ $idle_seconds -lt 2 ]]; then
        echo "${STATUS_RUNNING}|${C_GREEN}"
        return
    fi

    # Check if waiting for input (prompt patterns)
    # Claude Code shows ">" when waiting for input
    if echo "$last_line" | grep -qE '(^>|› |% ?$|\$ ?$|❯ ?$)'; then
        echo "${STATUS_WAITING}|${C_YELLOW}"
        return
    fi

    # Idle for more than 30 seconds
    if [[ $idle_seconds -gt 30 ]]; then
        echo "${STATUS_IDLE}|${C_DIM}"
        return
    fi

    # Default: waiting (recently active but not at prompt)
    echo "${STATUS_WAITING}|${C_YELLOW}"
}

# Get a brief preview of the session (last meaningful content)
# Shows last few lines of actual text content
get_session_preview() {
    local session="$1"
    local max_len="${2:-70}"
    local max_lines="${3:-3}"

    # Capture pane content and strip ANSI escapes
    local pane_content
    pane_content=$(tmux capture-pane -t "$session" -p -S -20 2>/dev/null | \
        sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | \
        tr -d '\000-\010\013-\037') || {
        echo ""
        return
    }

    # Collect meaningful lines
    local -a lines=()
    while IFS= read -r line; do
        # Skip empty/whitespace lines
        [[ -z "${line// }" ]] && continue

        # Count alphanumeric chars - skip lines that are mostly special chars
        local alnum="${line//[^a-zA-Z0-9 ]/}"
        [[ ${#alnum} -lt 5 ]] && continue

        # Skip known Claude UI elements
        [[ "$line" == *"for shortcuts"* ]] && continue
        [[ "$line" == *"for help"* ]] && continue
        [[ "$line" =~ ^[[:space:]]*\?[[:space:]] ]] && continue

        # Clean and truncate
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '|' '-' | tr '␤' ' ')
        [[ ${#line} -gt $max_len ]] && line="${line:0:$((max_len - 1))}…"
        [[ -n "$line" ]] && lines+=("$line")
    done <<< "$pane_content"

    # Get last N lines
    local count=${#lines[@]}
    local start=$((count > max_lines ? count - max_lines : 0))
    local preview=""
    for ((i = start; i < count; i++)); do
        [[ -n "$preview" ]] && preview+="␤"
        preview+="${lines[$i]}"
    done

    echo "$preview"
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

# Simple new session prompt
# Sets _CMUX_PICKED_DIR and _CMUX_PICKED_TITLE
_CMUX_PICKED_DIR=""
_CMUX_PICKED_TITLE=""

prompt_for_path() {
    _CMUX_PICKED_DIR=""
    _CMUX_PICKED_TITLE=""

    printf "${C_BOLD}New Session${C_RESET}\n\n"
    printf "${C_DIM}Path (blank=current dir, q=cancel):${C_RESET} "
    read -r _CMUX_PICKED_DIR

    # Handle cancel
    if [[ "$_CMUX_PICKED_DIR" == "q" || "$_CMUX_PICKED_DIR" == "Q" ]]; then
        _CMUX_PICKED_DIR=""
        return 1
    fi

    # Default to current dir, expand ~
    _CMUX_PICKED_DIR="${_CMUX_PICKED_DIR:-.}"
    _CMUX_PICKED_DIR="${_CMUX_PICKED_DIR/#\~/$HOME}"

    # Ask for optional title
    printf "${C_DIM}Title (blank=auto):${C_RESET} "
    read -r _CMUX_PICKED_TITLE

    return 0
}

cmd_new() {
    local mobile=false
    local path=""
    local title=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mobile|-m)
                mobile=true
                shift
                ;;
            --title|-t)
                title="$2"
                shift 2
                ;;
            *)
                path="$1"
                shift
                ;;
        esac
    done

    path="${path:-.}"

    # Validate path
    if [[ ! -d "$path" ]]; then
        die "Directory does not exist: $path"
    fi

    local abs_path
    abs_path=$(cd "$path" && pwd)

    local session_name
    session_name=$(generate_session_name "$abs_path")

    # Create session
    # For mobile: use fixed width; otherwise: use current terminal size
    if [[ "$mobile" == true ]]; then
        tmux new-session -d -s "$session_name" -c "$abs_path" -x "$CMUX_MOBILE_WIDTH"
    else
        # Capture current terminal size so claude starts at correct dimensions
        local cols lines
        cols=$(tput cols 2>/dev/null || echo 80)
        lines=$(tput lines 2>/dev/null || echo 24)
        tmux new-session -d -s "$session_name" -c "$abs_path" -x "$cols" -y "$lines"
    fi

    # Set environment variables
    tmux set-environment -t "$session_name" CMUX_SESSION "$session_name"
    tmux set-environment -t "$session_name" CMUX_DIR "$abs_path"
    [[ -n "$title" ]] && tmux set-environment -t "$session_name" CMUX_TITLE "$title"

    # Launch claude in the session
    tmux send-keys -t "$session_name" "claude" Enter

    echo "Created session: $session_name"

    # Attach or switch
    if is_inside_tmux; then
        tmux switch-client -t "$session_name"
    else
        tmux attach-session -t "$session_name"
    fi
}

cmd_list() {
    local sessions
    sessions=$(get_sessions)

    if [[ -z "$sessions" ]]; then
        echo "No cmux sessions"
        return 0
    fi

    # Print legend
    printf "${C_GREEN}${STATUS_RUNNING}${C_RESET}running ${C_YELLOW}${STATUS_WAITING}${C_RESET}waiting ${C_DIM}${STATUS_IDLE}idle${C_RESET} ${C_RED}${STATUS_ERROR}${C_RESET}error\n\n"

    echo "$sessions" | while IFS='|' read -r name created; do
        local title age child status_info status_sym status_color display_name
        title=$(get_session_title "$name")
        age=$(format_age "$created")
        child=$(get_session_child "$name")
        status_info=$(get_session_status "$name")
        status_sym=$(echo "$status_info" | cut -d'|' -f1)
        status_color=$(echo "$status_info" | cut -d'|' -f2)

        # Title is primary if set
        if [[ -n "$title" ]]; then
            display_name="$title"
            printf "${status_color}${status_sym}${C_RESET} %s\t${C_DIM}(%s)${C_RESET}\t%s\n" "$display_name" "$child" "$age"
        else
            printf "${status_color}${status_sym}${C_RESET} %s\t\t%s\n" "$child" "$age"
        fi
    done
}

cmd_attach() {
    local target="$1"

    # Try exact match first (full name with any parent)
    local session=""
    session=$(get_sessions | cut -d'|' -f1 | grep -E "${CMUX_SEP}${target}\$" | head -1)

    if [[ -z "$session" ]]; then
        # Try partial match
        session=$(get_sessions | cut -d'|' -f1 | grep -F "$target" | head -1)
    fi

    if [[ -z "$session" ]]; then
        die "No session matching: $target"
    fi

    if is_inside_tmux; then
        tmux switch-client -t "$session"
    else
        tmux attach-session -t "$session"
    fi
}

cmd_switch() {
    if ! is_inside_tmux; then
        die "Not inside tmux. Use 'cmux' instead."
    fi

    show_selector switch
}

cmd_kill() {
    local target="$1"

    # Try exact match first (full name with any parent)
    local session=""
    session=$(get_sessions | cut -d'|' -f1 | grep -E "${CMUX_SEP}${target}\$" | head -1)

    if [[ -z "$session" ]]; then
        # Try partial match
        session=$(get_sessions | cut -d'|' -f1 | grep -F "$target" | head -1)
    fi

    if [[ -z "$session" ]]; then
        die "No session matching: $target"
    fi

    tmux kill-session -t "$session"
    echo "Killed session: $session"
}

cmd_rename() {
    local new_name="$1"

    if ! is_inside_tmux; then
        die "Not inside tmux session"
    fi

    local current
    current=$(tmux display-message -p '#{session_name}')

    if [[ ! "$current" =~ ^${CMUX_PREFIX}${CMUX_SEP} ]]; then
        die "Not in a cmux session"
    fi

    # Build new full name preserving prefix structure
    local parent
    parent=$(get_session_parent "$current")
    local new_full="${CMUX_PREFIX}${CMUX_SEP}${parent}${CMUX_SEP}${new_name}"

    tmux rename-session -t "$current" "$new_full"
    tmux set-environment -t "$new_full" CMUX_SESSION "$new_full"
    echo "Renamed to: $new_full"
}

cmd_title() {
    local title="$1"

    if ! is_inside_tmux; then
        die "Not inside tmux session"
    fi

    local current
    current=$(tmux display-message -p '#{session_name}')

    if [[ ! "$current" =~ ^${CMUX_PREFIX}${CMUX_SEP} ]]; then
        die "Not in a cmux session"
    fi

    tmux set-environment -t "$current" CMUX_TITLE "$title"
    echo "Title set: $title"
}

cmd_info() {
    if ! is_inside_tmux; then
        die "Not inside tmux session"
    fi

    local current
    current=$(tmux display-message -p '#{session_name}')

    if [[ ! "$current" =~ ^${CMUX_PREFIX}${CMUX_SEP} ]]; then
        die "Not in a cmux session"
    fi

    local title
    title=$(get_session_title "$current")
    local dir
    dir=$(get_session_dir "$current")
    local created
    created=$(tmux display-message -p -t "$current" '#{session_created}')
    local age
    age=$(format_age "$created")

    echo "Session: $current"
    echo "Directory: $dir"
    echo "Title: ${title:-<not set>}"
    echo "Age: $age"
}

# ─────────────────────────────────────────────────────────────────────────────
# Interactive Selector (arrow key navigation)
# ─────────────────────────────────────────────────────────────────────────────

# Read a single keypress (handles arrow keys)
read_key() {
    local key
    IFS= read -rsn1 key 2>/dev/null || return 1

    # Handle escape sequences (arrow keys)
    # Note: bash 3.2 doesn't support fractional -t, so we use -t1
    # but read the escape sequence bytes immediately
    if [[ "$key" == $'\e' ]]; then
        local seq
        read -rsn1 -t1 seq 2>/dev/null || true
        if [[ "$seq" == "[" ]]; then
            read -rsn1 -t1 seq 2>/dev/null || true
            case "$seq" in
                'A') echo "up"; return ;;
                'B') echo "down"; return ;;
                'C') echo "right"; return ;;
                'D') echo "left"; return ;;
            esac
        fi
        echo "escape"
        return
    fi

    case "$key" in
        '') echo "enter" ;;
        q|Q) echo "quit" ;;
        n|N) echo "new" ;;
        d|D) echo "delete" ;;
        j) echo "down" ;;
        k) echo "up" ;;
        *) echo "$key" ;;
    esac
}

show_selector() {
    local mode="${1:-attach}"  # attach or switch

    local sessions
    sessions=$(get_sessions)

    if [[ -z "$sessions" ]]; then
        echo ""
        printf "${C_BOLD}${C_CYAN}CMUX Sessions${C_RESET}\n"
        echo ""
        printf "  ${C_DIM}No active sessions${C_RESET}\n"
        echo ""
        printf "${C_DIM}────────────────────────${C_RESET}\n"
        printf "  ${C_YELLOW}[n]${C_RESET} New session\n"
        printf "  ${C_DIM}[q]${C_RESET} Quit\n"
        echo ""
        printf "${C_DIM}Select:${C_RESET} "
        read -r choice

        case "$choice" in
            n|N)
                prompt_for_path
                if [[ -n "$_CMUX_PICKED_DIR" ]]; then
                    if [[ -n "$_CMUX_PICKED_TITLE" ]]; then
                        cmd_new "$_CMUX_PICKED_DIR" --title "$_CMUX_PICKED_TITLE"
                    else
                        cmd_new "$_CMUX_PICKED_DIR"
                    fi
                fi
                ;;
            *)
                return 0
                ;;
        esac
        return 0
    fi

    # Build session list (bash 3.2 compatible)
    local session_count=0
    local session_data=""

    while IFS='|' read -r name created; do
        local parent child title age status_info status_sym status_color preview
        parent=$(get_session_parent "$name")
        child=$(get_session_child "$name")
        title=$(get_session_title "$name")
        age=$(format_age "$created")
        status_info=$(get_session_status "$name")
        status_sym="${status_info%%|*}"
        status_color="${status_info#*|}"
        preview=$(get_session_preview "$name" 80 6)
        # Ensure preview has no newlines
        preview="${preview//$'\n'/ }"

        session_count=$((session_count + 1))
        # Store as tab-separated for reliability (previews may have special chars)
        session_data+="${session_count}|${parent}|${child}|${title}|${age}|${name}|${status_sym}|${status_color}|${preview}"$'\n'
    done <<< "$sessions"

    # Menu items: sessions + "New session" + "Quit"
    local total_items=$((session_count + 2))
    local new_idx=$((session_count + 1))
    local quit_idx=$((session_count + 2))
    local selected=1

    # Hide cursor and clear screen once
    printf '\e[?25l\e[2J'

    # Cleanup on exit
    trap 'printf "\e[?25h\e[?1049l"; stty echo 2>/dev/null' EXIT INT TERM

    # Disable echo for key reading
    stty -echo 2>/dev/null || true

    # Get unique parents (sorted) - compute once
    local parents
    parents=$(echo "$session_data" | cut -d'|' -f2 | sort -u)

    # Track selected preview for bottom panel
    local selected_preview=""

    # Get terminal height for adaptive preview
    local term_lines
    term_lines=$(tput lines 2>/dev/null || echo 24)

    # Calculate max preview lines: total - header(4) - sessions - footer(3) - buffer(2)
    # Minimum 2 lines, maximum 8 lines
    local max_preview_lines=$(( term_lines - session_count - 12 ))
    [[ $max_preview_lines -lt 2 ]] && max_preview_lines=2
    [[ $max_preview_lines -gt 8 ]] && max_preview_lines=8

    while true; do
        # Move cursor to home (no clear - just overwrite)
        printf '\e[H'

        # Build output in variable to reduce flicker
        local output=""
        output+="${C_BOLD}${C_CYAN}CMUX${C_RESET} ${C_DIM}↑↓ nav · enter sel · n new · d del · q quit${C_RESET}\e[K\n"
        output+="${C_GREEN}${STATUS_RUNNING}${C_RESET}${C_DIM}run${C_RESET} ${C_YELLOW}${STATUS_WAITING}${C_RESET}${C_DIM}wait${C_RESET} ${C_DIM}${STATUS_IDLE}idle${C_RESET} ${C_RED}${STATUS_ERROR}${C_RESET}${C_DIM}err${C_RESET}\e[K\n"

        # === SESSION LIST (compact, no inline preview) ===
        selected_preview=""
        for parent in $parents; do
            output+="${C_BOLD}${C_BLUE}${parent}${C_RESET}\e[K\n"
            while IFS='|' read -r num p child title age fullname status_sym status_color preview; do
                [[ -z "$num" ]] && continue
                [[ "$p" != "$parent" ]] && continue

                # Build display name - title is primary if set
                local display_name="" display_secondary=""
                if [[ -n "$title" ]]; then
                    display_name="$title"
                    display_secondary="($child)"
                else
                    display_name="$child"
                fi

                if [[ "$num" -eq "$selected" ]]; then
                    # Selected item
                    output+="${status_color}${status_sym}${C_RESET} ${C_GREEN}▸${C_RESET}$(printf '%2s' "$num")  ${C_BOLD}${display_name}${C_RESET}"
                    [[ -n "$display_secondary" ]] && output+=" ${C_DIM}${display_secondary}${C_RESET}"
                    output+="  ${C_DIM}${age}${C_RESET}\e[K\n"
                    selected_preview="$preview"
                else
                    # Normal item
                    output+="${status_color}${status_sym}${C_RESET}  $(printf '%2s' "$num")  ${C_CYAN}${display_name}${C_RESET}"
                    [[ -n "$display_secondary" ]] && output+=" ${C_DIM}${display_secondary}${C_RESET}"
                    output+="  ${C_DIM}${age}${C_RESET}\e[K\n"
                fi
            done <<< "$session_data"
        done

        # === PREVIEW PANEL (adaptive height) ===
        output+="${C_DIM}──────────────────────────────────────────────────────────────${C_RESET}\e[K\n"
        local preview_line_count=0
        if [[ -n "$selected_preview" ]]; then
            while IFS= read -r pline; do
                ((preview_line_count++))
                [[ $preview_line_count -gt $max_preview_lines ]] && break
                output+="${C_DIM}${pline}${C_RESET}\e[K\n"
            done <<< "${selected_preview//␤/$'\n'}"
        fi
        # Pad remaining preview lines to prevent ghosting
        while [[ $preview_line_count -lt $max_preview_lines ]]; do
            output+="\e[K\n"
            ((preview_line_count++))
        done

        # === FOOTER ===
        output+="${C_DIM}──────────────────────────────────────────────────────────────${C_RESET}\e[K\n"
        if [[ "$selected" -eq "$new_idx" ]]; then
            output+="${C_GREEN}▸${C_RESET}${C_BOLD}[n] New${C_RESET}  ${C_DIM}[d] Delete  [q] Quit${C_RESET}\e[K\n"
        elif [[ "$selected" -eq "$quit_idx" ]]; then
            output+="${C_DIM}[n] New  [d] Delete${C_RESET}  ${C_GREEN}▸${C_RESET}${C_BOLD}[q] Quit${C_RESET}\e[K\n"
        else
            output+="${C_DIM}[n] New  [d] Delete  [q] Quit${C_RESET}\e[K\n"
        fi

        printf '%b' "$output"

        # Read key
        local key
        key=$(read_key)

        case "$key" in
            up)
                selected=$((selected - 1))
                [[ "$selected" -lt 1 ]] && selected=$total_items
                ;;
            down)
                selected=$((selected + 1))
                [[ "$selected" -gt "$total_items" ]] && selected=1
                ;;
            enter)
                # Restore terminal
                printf '\e[?25h'
                stty echo 2>/dev/null || true

                if [[ "$selected" -eq "$quit_idx" ]]; then
                    return 0
                elif [[ "$selected" -eq "$new_idx" ]]; then
                    printf '\e[2J\e[H'  # Clear screen
                    prompt_for_path
                    if [[ -n "$_CMUX_PICKED_DIR" ]]; then
                        if [[ -n "$_CMUX_PICKED_TITLE" ]]; then
                            cmd_new "$_CMUX_PICKED_DIR" --title "$_CMUX_PICKED_TITLE"
                        else
                            cmd_new "$_CMUX_PICKED_DIR"
                        fi
                    fi
                    return 0
                else
                    # Get session by index
                    local target_session
                    target_session=$(echo "$session_data" | awk -F'|' -v idx="$selected" '$1 == idx {print $6}')
                    if [[ -n "$target_session" ]]; then
                        if [[ "$mode" == "switch" ]] || is_inside_tmux; then
                            tmux switch-client -t "$target_session"
                        else
                            tmux attach-session -t "$target_session"
                        fi
                    fi
                    return 0
                fi
                ;;
            quit)
                printf '\e[?25h'
                stty echo 2>/dev/null || true
                return 0
                ;;
            new)
                printf '\e[?25h\e[2J\e[H'  # Show cursor, clear screen
                stty echo 2>/dev/null || true
                prompt_for_path
                if [[ -n "$_CMUX_PICKED_DIR" ]]; then
                    if [[ -n "$_CMUX_PICKED_TITLE" ]]; then
                        cmd_new "$_CMUX_PICKED_DIR" --title "$_CMUX_PICKED_TITLE"
                    else
                        cmd_new "$_CMUX_PICKED_DIR"
                    fi
                fi
                return 0
                ;;
            delete)
                # Only delete if a session is selected (not new/quit)
                if [[ "$selected" -le "$session_count" ]]; then
                    local target_session target_name
                    target_session=$(echo "$session_data" | awk -F'|' -v idx="$selected" '$1 == idx {print $6}')
                    target_name=$(echo "$session_data" | awk -F'|' -v idx="$selected" '$1 == idx { if ($4 != "") print $4; else print $3 }')

                    if [[ -n "$target_session" ]]; then
                        # Show confirmation prompt
                        printf '\e[?25h'  # Show cursor
                        stty echo 2>/dev/null || true
                        printf "\n${C_YELLOW}Delete session '${target_name}'? [y/N]:${C_RESET} "
                        local confirm
                        read -r confirm
                        if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                            tmux kill-session -t "$target_session" 2>/dev/null && \
                                printf "${C_GREEN}Deleted.${C_RESET}\n" || \
                                printf "${C_RED}Failed to delete.${C_RESET}\n"
                            sleep 0.5
                            # Restart selector with refreshed data
                            printf '\e[?25l'  # Hide cursor
                            stty -echo 2>/dev/null || true
                            show_selector "$mode"
                            return 0
                        fi
                        # Re-hide cursor and continue
                        printf '\e[?25l'
                        stty -echo 2>/dev/null || true
                    fi
                fi
                ;;
            [1-9])
                # Direct number selection
                if [[ "$key" -le "$session_count" ]]; then
                    printf '\e[?25h'
                    stty echo 2>/dev/null || true
                    local target_session
                    target_session=$(echo "$session_data" | awk -F'|' -v idx="$key" '$1 == idx {print $6}')
                    if [[ -n "$target_session" ]]; then
                        if [[ "$mode" == "switch" ]] || is_inside_tmux; then
                            tmux switch-client -t "$target_session"
                        else
                            tmux attach-session -t "$target_session"
                        fi
                    fi
                    return 0
                fi
                ;;
        esac
    done
}

cmd_help() {
    cat <<EOF
cmux v${VERSION} - Claude Tmux Session Manager

USAGE:
    cmux                     Interactive session selector
    cmux new [opts] [path]   Create new session (default: current dir)
    cmux list                List all sessions
    cmux attach <name>       Attach to session
    cmux switch              Switch sessions (inside tmux)
    cmux kill <name>         Kill a session
    cmux rename <name>       Rename current session
    cmux title <text>        Set session title
    cmux info                Show current session info
    cmux help                Show this help

OPTIONS:
    -m, --mobile             Create session at fixed 78-col width
    -t, --title <text>       Set session title on creation

STATUS INDICATORS:
    ●  Running   - Claude is actively generating output
    ◐  Waiting   - Claude is waiting for your input
    ○  Idle      - Session has been idle for a while
    ✕  Error     - Error detected in session

ALIASES:
    s = selector, sw = switch, ls = list, a = attach, k = kill, t = title, i = info

EXAMPLES:
    cmux new ~/projects/my-app       Create session for my-app
    cmux new --mobile ~/my-app       Create mobile-friendly session (78 cols)
    cmux attach my-app               Attach to my-app session
    cmux title "fixing auth bug"     Set descriptive title

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    # Check tmux is available
    if ! command -v tmux &>/dev/null; then
        die "tmux is not installed"
    fi

    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        "")
            # Show selector - uses switch if inside tmux, attach otherwise
            show_selector attach
            ;;
        new)
            cmd_new "$@"
            ;;
        list|ls)
            cmd_list
            ;;
        attach|a)
            [[ -z "${1:-}" ]] && die "Usage: cmux attach <name>"
            cmd_attach "$1"
            ;;
        switch|sw)
            cmd_switch
            ;;
        selector|s)
            # Selector works from anywhere - uses switch if inside tmux, attach otherwise
            show_selector attach
            ;;
        kill|k)
            [[ -z "${1:-}" ]] && die "Usage: cmux kill <name>"
            cmd_kill "$1"
            ;;
        rename)
            [[ -z "${1:-}" ]] && die "Usage: cmux rename <new-name>"
            cmd_rename "$1"
            ;;
        title|t)
            [[ -z "${1:-}" ]] && die "Usage: cmux title <text>"
            cmd_title "$1"
            ;;
        info|i)
            cmd_info
            ;;
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "cmux v${VERSION}"
            ;;
        *)
            die "Unknown command: $cmd. Run 'cmux help' for usage."
            ;;
    esac
}

main "$@"
