#!/usr/bin/env bash
#
# cmux - Claude Tmux Session Manager
# Manage multiple Claude Code sessions via tmux
#

set -euo pipefail

VERSION="1.0.0"
# Using @ as separator since colons conflict with tmux session:window syntax
# and underscores are common in directory names
CMUX_PREFIX="cmux"
CMUX_SEP="@"

# Mobile-friendly terminal width (used with --mobile flag)
# Claude Code doesn't handle resize well, so mobile sessions start narrow
CMUX_MOBILE_WIDTH=78

# Colors (subtle, modern palette)
C_RESET='\e[0m'
C_BOLD='\e[1m'
C_DIM='\e[2m'
C_CYAN='\e[36m'
C_GREEN='\e[32m'
C_YELLOW='\e[33m'
C_BLUE='\e[34m'
C_MAGENTA='\e[35m'

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

die() {
    echo "Error: $1" >&2
    exit 1
}

is_inside_tmux() {
    [[ -n "${TMUX:-}" ]]
}

# Get all cmux sessions (sessions starting with cmux prefix)
get_sessions() {
    tmux list-sessions -F "#{session_name}|#{session_created}" 2>/dev/null | \
        grep "^${CMUX_PREFIX}${CMUX_SEP}" || true
}

# Get session title from tmux environment
get_session_title() {
    local session="$1"
    tmux show-environment -t "$session" CMUX_TITLE 2>/dev/null | sed 's/^CMUX_TITLE=//' || echo ""
}

# Get session working directory
get_session_dir() {
    local session="$1"
    tmux show-environment -t "$session" CMUX_DIR 2>/dev/null | sed 's/^CMUX_DIR=//' || echo ""
}

# Format age from seconds to human readable
format_age() {
    local created="$1"
    local now
    now=$(date +%s)
    local diff=$((now - created))

    if ((diff < 60)); then
        echo "${diff}s"
    elif ((diff < 3600)); then
        echo "$((diff / 60))m"
    elif ((diff < 86400)); then
        echo "$((diff / 3600))h"
    else
        echo "$((diff / 86400))d"
    fi
}

# Generate session name from path
# /projects/rebar-cosmos/aggregation-logic → cmux_rebar-cosmos_aggregation-logic
generate_session_name() {
    local path="$1"
    local abs_path
    abs_path=$(cd "$path" && pwd)

    local parent
    parent=$(basename "$(dirname "$abs_path")")
    local child
    child=$(basename "$abs_path")

    local base_name="${CMUX_PREFIX}${CMUX_SEP}${parent}${CMUX_SEP}${child}"
    local name="$base_name"
    local counter=2

    # Handle duplicates
    while tmux has-session -t "$name" 2>/dev/null; do
        name="${base_name}-${counter}"
        ((counter++))
    done

    echo "$name"
}

# Extract parent from session name for grouping
# cmux@rebar-cosmos@aggregation-logic → rebar-cosmos
get_session_parent() {
    local session="$1"
    echo "$session" | cut -d"${CMUX_SEP}" -f2
}

# Extract child from session name
# cmux@rebar-cosmos@aggregation-logic → aggregation-logic
get_session_child() {
    local session="$1"
    echo "$session" | cut -d"${CMUX_SEP}" -f3-
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_new() {
    local mobile=false
    local path=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mobile|-m)
                mobile=true
                shift
                ;;
            *)
                path="$1"
                shift
                ;;
        esac
    done

    path="${path:-.}"

    # Validate path
    if [[ ! -d "$path" ]]; then
        die "Directory does not exist: $path"
    fi

    local abs_path
    abs_path=$(cd "$path" && pwd)

    local session_name
    session_name=$(generate_session_name "$abs_path")

    # Create session
    # For mobile: use fixed width; otherwise: use current terminal size
    if [[ "$mobile" == true ]]; then
        tmux new-session -d -s "$session_name" -c "$abs_path" -x "$CMUX_MOBILE_WIDTH"
    else
        # Capture current terminal size so claude starts at correct dimensions
        local cols lines
        cols=$(tput cols 2>/dev/null || echo 80)
        lines=$(tput lines 2>/dev/null || echo 24)
        tmux new-session -d -s "$session_name" -c "$abs_path" -x "$cols" -y "$lines"
    fi

    # Set environment variables
    tmux set-environment -t "$session_name" CMUX_SESSION "$session_name"
    tmux set-environment -t "$session_name" CMUX_DIR "$abs_path"

    # Launch claude in the session
    tmux send-keys -t "$session_name" "claude" Enter

    echo "Created session: $session_name"

    # Attach or switch
    if is_inside_tmux; then
        tmux switch-client -t "$session_name"
    else
        tmux attach-session -t "$session_name"
    fi
}

cmd_list() {
    local sessions
    sessions=$(get_sessions)

    if [[ -z "$sessions" ]]; then
        echo "No cmux sessions"
        return 0
    fi

    echo "$sessions" | while IFS='|' read -r name created; do
        local title
        title=$(get_session_title "$name")
        local age
        age=$(format_age "$created")
        local child
        child=$(get_session_child "$name")

        if [[ -n "$title" ]]; then
            printf "%s\t[%s]\t%s\n" "$child" "$title" "$age"
        else
            printf "%s\t\t%s\n" "$child" "$age"
        fi
    done
}

cmd_attach() {
    local target="$1"

    # Try exact match first (full name with any parent)
    local session=""
    session=$(get_sessions | cut -d'|' -f1 | grep -E "${CMUX_SEP}${target}\$" | head -1)

    if [[ -z "$session" ]]; then
        # Try partial match
        session=$(get_sessions | cut -d'|' -f1 | grep -F "$target" | head -1)
    fi

    if [[ -z "$session" ]]; then
        die "No session matching: $target"
    fi

    if is_inside_tmux; then
        tmux switch-client -t "$session"
    else
        tmux attach-session -t "$session"
    fi
}

cmd_switch() {
    if ! is_inside_tmux; then
        die "Not inside tmux. Use 'cmux' instead."
    fi

    show_selector switch
}

cmd_kill() {
    local target="$1"

    # Try exact match first (full name with any parent)
    local session=""
    session=$(get_sessions | cut -d'|' -f1 | grep -E "${CMUX_SEP}${target}\$" | head -1)

    if [[ -z "$session" ]]; then
        # Try partial match
        session=$(get_sessions | cut -d'|' -f1 | grep -F "$target" | head -1)
    fi

    if [[ -z "$session" ]]; then
        die "No session matching: $target"
    fi

    tmux kill-session -t "$session"
    echo "Killed session: $session"
}

cmd_rename() {
    local new_name="$1"

    if ! is_inside_tmux; then
        die "Not inside tmux session"
    fi

    local current
    current=$(tmux display-message -p '#{session_name}')

    if [[ ! "$current" =~ ^${CMUX_PREFIX}${CMUX_SEP} ]]; then
        die "Not in a cmux session"
    fi

    # Build new full name preserving prefix structure
    local parent
    parent=$(get_session_parent "$current")
    local new_full="${CMUX_PREFIX}${CMUX_SEP}${parent}${CMUX_SEP}${new_name}"

    tmux rename-session -t "$current" "$new_full"
    tmux set-environment -t "$new_full" CMUX_SESSION "$new_full"
    echo "Renamed to: $new_full"
}

cmd_title() {
    local title="$1"

    if ! is_inside_tmux; then
        die "Not inside tmux session"
    fi

    local current
    current=$(tmux display-message -p '#{session_name}')

    if [[ ! "$current" =~ ^${CMUX_PREFIX}${CMUX_SEP} ]]; then
        die "Not in a cmux session"
    fi

    tmux set-environment -t "$current" CMUX_TITLE "$title"
    echo "Title set: $title"
}

cmd_info() {
    if ! is_inside_tmux; then
        die "Not inside tmux session"
    fi

    local current
    current=$(tmux display-message -p '#{session_name}')

    if [[ ! "$current" =~ ^${CMUX_PREFIX}${CMUX_SEP} ]]; then
        die "Not in a cmux session"
    fi

    local title
    title=$(get_session_title "$current")
    local dir
    dir=$(get_session_dir "$current")
    local created
    created=$(tmux display-message -p -t "$current" '#{session_created}')
    local age
    age=$(format_age "$created")

    echo "Session: $current"
    echo "Directory: $dir"
    echo "Title: ${title:-<not set>}"
    echo "Age: $age"
}

# ─────────────────────────────────────────────────────────────────────────────
# Interactive Selector (arrow key navigation)
# ─────────────────────────────────────────────────────────────────────────────

# Read a single keypress (handles arrow keys)
read_key() {
    local key
    IFS= read -rsn1 key 2>/dev/null || return 1

    # Handle escape sequences (arrow keys)
    # Note: bash 3.2 doesn't support fractional -t, so we use -t1
    # but read the escape sequence bytes immediately
    if [[ "$key" == $'\e' ]]; then
        local seq
        read -rsn1 -t1 seq 2>/dev/null || true
        if [[ "$seq" == "[" ]]; then
            read -rsn1 -t1 seq 2>/dev/null || true
            case "$seq" in
                'A') echo "up"; return ;;
                'B') echo "down"; return ;;
                'C') echo "right"; return ;;
                'D') echo "left"; return ;;
            esac
        fi
        echo "escape"
        return
    fi

    case "$key" in
        '') echo "enter" ;;
        q|Q) echo "quit" ;;
        n|N) echo "new" ;;
        j) echo "down" ;;
        k) echo "up" ;;
        *) echo "$key" ;;
    esac
}

show_selector() {
    local mode="${1:-attach}"  # attach or switch

    local sessions
    sessions=$(get_sessions)

    if [[ -z "$sessions" ]]; then
        echo ""
        printf "${C_BOLD}${C_CYAN}CMUX Sessions${C_RESET}\n"
        echo ""
        printf "  ${C_DIM}No active sessions${C_RESET}\n"
        echo ""
        printf "${C_DIM}────────────────────────${C_RESET}\n"
        printf "  ${C_YELLOW}[n]${C_RESET} New session\n"
        printf "  ${C_DIM}[q]${C_RESET} Quit\n"
        echo ""
        printf "${C_DIM}Select:${C_RESET} "
        read -r choice

        case "$choice" in
            n|N)
                printf "Path: "
                read -r path
                cmd_new "${path:-.}"
                ;;
            *)
                return 0
                ;;
        esac
        return 0
    fi

    # Build session list (bash 3.2 compatible)
    local session_count=0
    local session_data=""

    while IFS='|' read -r name created; do
        local parent child title age
        parent=$(get_session_parent "$name")
        child=$(get_session_child "$name")
        title=$(get_session_title "$name")
        age=$(format_age "$created")

        session_count=$((session_count + 1))
        # Store: idx|parent|child|title|age|fullname
        session_data="${session_data}${session_count}|${parent}|${child}|${title}|${age}|${name}"$'\n'
    done <<< "$sessions"

    # Menu items: sessions + "New session" + "Quit"
    local total_items=$((session_count + 2))
    local new_idx=$((session_count + 1))
    local quit_idx=$((session_count + 2))
    local selected=1

    # Hide cursor and clear screen once
    printf '\e[?25l\e[2J'

    # Cleanup on exit
    trap 'printf "\e[?25h\e[?1049l"; stty echo 2>/dev/null' EXIT INT TERM

    # Disable echo for key reading
    stty -echo 2>/dev/null || true

    # Get unique parents (sorted) - compute once
    local parents
    parents=$(echo "$session_data" | cut -d'|' -f2 | sort -u)

    while true; do
        # Move cursor to home (no clear - just overwrite)
        printf '\e[H'

        # Build output in variable to reduce flicker
        local output=""
        output+="\n"
        output+="${C_BOLD}${C_CYAN}CMUX Sessions${C_RESET}  ${C_DIM}↑/↓ move · enter select · q quit${C_RESET}\e[K\n"
        output+="\n"

        # Display grouped by parent
        for parent in $parents; do
            output+="${C_BOLD}${C_BLUE}${parent}${C_RESET}\e[K\n"
            while IFS='|' read -r num p child title age fullname; do
                [[ -z "$num" ]] && continue
                [[ "$p" != "$parent" ]] && continue

                if [[ "$num" -eq "$selected" ]]; then
                    # Selected item - highlighted
                    if [[ -n "$title" ]]; then
                        output+="${C_GREEN}▸ $(printf '%2s' "$num")) ${C_BOLD}$(printf '%-20s' "$child")${C_RESET} ${C_DIM}[$(printf '%-20s' "$title")]${C_RESET} ${C_DIM}${age}${C_RESET}\e[K\n"
                    else
                        output+="${C_GREEN}▸ $(printf '%2s' "$num")) ${C_BOLD}$(printf '%-20s' "$child")${C_RESET} ${C_DIM}$(printf '%-22s' "")${C_RESET} ${C_DIM}${age}${C_RESET}\e[K\n"
                    fi
                else
                    # Normal item
                    if [[ -n "$title" ]]; then
                        output+="  $(printf '%2s' "$num")) ${C_CYAN}$(printf '%-20s' "$child")${C_RESET} ${C_DIM}[$(printf '%-20s' "$title")]${C_RESET} ${C_DIM}${age}${C_RESET}\e[K\n"
                    else
                        output+="  $(printf '%2s' "$num")) ${C_CYAN}$(printf '%-20s' "$child")${C_RESET} ${C_DIM}$(printf '%-22s' "")${C_RESET} ${C_DIM}${age}${C_RESET}\e[K\n"
                    fi
                fi
            done <<< "$session_data"
            output+="\e[K\n"
        done

        output+="${C_DIM}────────────────────────${C_RESET}\e[K\n"

        # New session option
        if [[ "$selected" -eq "$new_idx" ]]; then
            output+="${C_GREEN}▸${C_RESET} ${C_YELLOW}[n]${C_RESET} ${C_BOLD}New session${C_RESET}\e[K\n"
        else
            output+="  ${C_DIM}[n]${C_RESET} New session\e[K\n"
        fi

        # Quit option
        if [[ "$selected" -eq "$quit_idx" ]]; then
            output+="${C_GREEN}▸${C_RESET} ${C_DIM}[q]${C_RESET} ${C_BOLD}Quit${C_RESET}\e[K\n"
        else
            output+="  ${C_DIM}[q]${C_RESET} Quit\e[K\n"
        fi

        # Print all at once
        printf '%b' "$output"

        # Read key
        local key
        key=$(read_key)

        case "$key" in
            up)
                selected=$((selected - 1))
                [[ "$selected" -lt 1 ]] && selected=$total_items
                ;;
            down)
                selected=$((selected + 1))
                [[ "$selected" -gt "$total_items" ]] && selected=1
                ;;
            enter)
                # Restore terminal
                printf '\e[?25h'
                stty echo 2>/dev/null || true

                if [[ "$selected" -eq "$quit_idx" ]]; then
                    return 0
                elif [[ "$selected" -eq "$new_idx" ]]; then
                    printf "Path: "
                    read -r path
                    cmd_new "${path:-.}"
                    return 0
                else
                    # Get session by index
                    local target_session
                    target_session=$(echo "$session_data" | awk -F'|' -v idx="$selected" '$1 == idx {print $6}')
                    if [[ -n "$target_session" ]]; then
                        if [[ "$mode" == "switch" ]] || is_inside_tmux; then
                            tmux switch-client -t "$target_session"
                        else
                            tmux attach-session -t "$target_session"
                        fi
                    fi
                    return 0
                fi
                ;;
            quit)
                printf '\e[?25h'
                stty echo 2>/dev/null || true
                return 0
                ;;
            new)
                printf '\e[?25h'
                stty echo 2>/dev/null || true
                printf "Path: "
                read -r path
                cmd_new "${path:-.}"
                return 0
                ;;
            [1-9])
                # Direct number selection
                if [[ "$key" -le "$session_count" ]]; then
                    printf '\e[?25h'
                    stty echo 2>/dev/null || true
                    local target_session
                    target_session=$(echo "$session_data" | awk -F'|' -v idx="$key" '$1 == idx {print $6}')
                    if [[ -n "$target_session" ]]; then
                        if [[ "$mode" == "switch" ]] || is_inside_tmux; then
                            tmux switch-client -t "$target_session"
                        else
                            tmux attach-session -t "$target_session"
                        fi
                    fi
                    return 0
                fi
                ;;
        esac
    done
}

cmd_help() {
    cat <<EOF
cmux v${VERSION} - Claude Tmux Session Manager

USAGE:
    cmux                     Interactive session selector
    cmux new [-m] [path]     Create new session (default: current dir)
    cmux list                List all sessions
    cmux attach <name>       Attach to session
    cmux switch              Switch sessions (inside tmux)
    cmux kill <name>         Kill a session
    cmux rename <name>       Rename current session
    cmux title <text>        Set session title
    cmux info                Show current session info
    cmux help                Show this help

OPTIONS:
    -m, --mobile             Create session at fixed 78-col width

ALIASES:
    s = selector, sw = switch, ls = list, a = attach, k = kill, t = title, i = info

EXAMPLES:
    cmux new ~/projects/my-app       Create session for my-app
    cmux new --mobile ~/my-app       Create mobile-friendly session (78 cols)
    cmux attach my-app               Attach to my-app session
    cmux title "fixing auth bug"     Set descriptive title

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    # Check tmux is available
    if ! command -v tmux &>/dev/null; then
        die "tmux is not installed"
    fi

    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        "")
            # Show selector - uses switch if inside tmux, attach otherwise
            show_selector attach
            ;;
        new)
            cmd_new "$@"
            ;;
        list|ls)
            cmd_list
            ;;
        attach|a)
            [[ -z "${1:-}" ]] && die "Usage: cmux attach <name>"
            cmd_attach "$1"
            ;;
        switch|sw)
            cmd_switch
            ;;
        selector|s)
            # Selector works from anywhere - uses switch if inside tmux, attach otherwise
            show_selector attach
            ;;
        kill|k)
            [[ -z "${1:-}" ]] && die "Usage: cmux kill <name>"
            cmd_kill "$1"
            ;;
        rename)
            [[ -z "${1:-}" ]] && die "Usage: cmux rename <new-name>"
            cmd_rename "$1"
            ;;
        title|t)
            [[ -z "${1:-}" ]] && die "Usage: cmux title <text>"
            cmd_title "$1"
            ;;
        info|i)
            cmd_info
            ;;
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "cmux v${VERSION}"
            ;;
        *)
            die "Unknown command: $cmd. Run 'cmux help' for usage."
            ;;
    esac
}

main "$@"
