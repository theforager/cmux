#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [[ -x "$SCRIPT_DIR/dist/cmux-go" ]]; then
  exec "$SCRIPT_DIR/dist/cmux-go" "$@"
fi

if [[ "${1:-}" == "legacy" ]]; then
  shift
  exec "$SCRIPT_DIR/legacy/cmux.bash" "$@"
fi

cat >&2 <<EOF
cmux Go binary is not built yet.

Run:
  mkdir -p dist
  go build -o dist/cmux-go ./cmd/cmux

Legacy cmux is still available:
  cmux legacy [command]
EOF
exit 1
